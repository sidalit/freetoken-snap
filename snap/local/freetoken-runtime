#!/bin/bash
freetoken_require_cuda() {
    if [[ ! -d "$SNAP_COMPONENTS/cuda/site-packages/torch" ]]; then
        echo "Local inference requires CUDA support; run: sudo snap install $SNAP_INSTANCE_NAME+cuda" >&2
        return 1
    fi
}

# Keep models and caches outside revisioned data.
freetoken_prepare_runtime() {
    export HOME="$1"
    export XDG_CACHE_HOME="$HOME/.cache"
    export HF_HOME="$XDG_CACHE_HOME/huggingface"
    export MODELSCOPE_CACHE="$XDG_CACHE_HOME/modelscope"
    export TRITON_CACHE_DIR="$HOME/.triton/cache"
    export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nvidia"
    mkdir -p "$XDG_CACHE_HOME"
}
