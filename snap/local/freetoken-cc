#!/bin/bash
# Keep the compiler, headers and libraries in the same component sysroot.
sysroot="$SNAP_COMPONENTS/cuda"
export LD_LIBRARY_PATH="$sysroot/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$sysroot/usr/bin:$PATH"
# Python's own include path points at the base snap, which has no headers.
exec "$sysroot/usr/bin/gcc" --sysroot="$sysroot" -I"$sysroot/usr/include/python3.12" "$@"
